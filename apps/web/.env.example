# URL e chave pública do seu projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chave secreta (Settings > API > service_role) — NUNCA exponha no app mobile ou no navegador.
# Usada apenas em rotas de servidor para criar contas de alunos.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opcional: só preencha se for conectar sua agenda ao Google Calendar.
# Veja o passo a passo no README, seção "Agenda e Google Calendar".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
